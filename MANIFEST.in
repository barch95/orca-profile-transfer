include README.md LICENSE THIRD_PARTY_NOTICES.md pyproject.toml .gitignore
recursive-include src *.py *.json
recursive-include scripts *.py
recursive-include tests *.py
recursive-include docs *.md
recursive-include .github/workflows *.yml
recursive-include third_party_licenses *.txt *.terms
global-exclude __pycache__ *.py[cod] *.3mf *.gcode *.stl *.log
